APP_ENV=development
DEBUG=false

# Local development uses SQLite. Full environments use PostgreSQL.
DATABASE_URL=sqlite:///./recoveriq.db
# DATABASE_URL=postgresql+psycopg://recoveriq:recoveriq@localhost:5432/recoveriq

REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=true

# Optional presentation data. The local CLI also requires APP_ENV=development.
ENABLE_DEMO_SEED=false

# Razorpay Test Mode only. Never place live credentials here.
EXECUTION_ENVIRONMENT=SIMULATION
RAZORPAY_MODE=test
RAZORPAY_TEST_SMOKE_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_API_VERSION=v1
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_RETRIES=3
GEMINI_THINKING_LEVEL=low

# Explanation enrichment is non-authoritative and falls back deterministically.
EXPLANATION_PROVIDER=fallback
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=20
GROQ_MAX_RETRIES=2

# Browser-accessible API base URL for the Next.js shell.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
