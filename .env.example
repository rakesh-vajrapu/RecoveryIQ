APP_ENV=development
DEBUG=false

# Local development uses SQLite. Full environments use PostgreSQL.
DATABASE_URL=sqlite:///./recoveriq.db
# DATABASE_URL=postgresql+psycopg://recoveriq:recoveriq@localhost:5432/recoveriq

REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=true

# Razorpay Test Mode only. Never place live credentials here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_API_VERSION=v1
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_RETRIES=3
GEMINI_THINKING_LEVEL=low

# Browser-accessible API base URL for the Next.js shell.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

